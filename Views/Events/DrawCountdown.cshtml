@model ChristmasGiftExchange.ViewModels.DrawCountdownViewModel
@{
    ViewData["Title"] = "公平抽籤中";
}

<meta http-equiv="refresh" content="5;url=@Model.ExecuteUrl" />

<section class="section-shell">
    <div class="draw-countdown-page">
        <div class="draw-countdown-card">
            <span class="hero-pill">Gift Draw</span>
            <h1>@Model.EventName</h1>
            <p>聖誕精靈正在交換禮物，5 秒後自動完成公平抽籤。</p>

            <div class="draw-stars">
                <span>✦</span>
                <span>❄</span>
                <span>✦</span>
                <span>❄</span>
                <span>✦</span>
            </div>

            <div class="draw-gift-row">
                <div class="draw-mini-gift draw-mini-gift-red"></div>
                <div class="draw-mini-gift draw-mini-gift-gold"></div>
                <div class="draw-mini-gift draw-mini-gift-green"></div>
            </div>

            <div class="draw-countdown" data-draw-countdown>5</div>
            <div class="draw-status">倒數結束後會自動跳轉，若沒有跳轉可按下方按鈕。</div>

            <a class="btn btn-gold mt-4" href="@Model.ExecuteUrl">立即完成抽籤</a>
        </div>
    </div>
</section>

<style>
    .draw-countdown-page {
        min-height: 70vh;
        display: grid;
        place-items: center;
    }

    .draw-countdown-card {
        width: min(680px, 100%);
        padding: 2.5rem 2rem;
        border-radius: 36px;
        background: linear-gradient(180deg, #fffaf1, #f3ebdb);
        color: #1d241f;
        text-align: center;
        box-shadow: 0 32px 70px rgba(0, 0, 0, 0.22);
    }

    .draw-countdown-card h1 {
        margin: 1rem 0 0.75rem;
    }

    .draw-stars {
        display: flex;
        justify-content: center;
        gap: 0.7rem;
        margin-top: 1.2rem;
        color: #d7a61a;
        font-size: 1.2rem;
        animation: drawTwinkle 1.1s ease-in-out infinite alternate;
    }

    .draw-gift-row {
        display: flex;
        justify-content: center;
        gap: 1.15rem;
        margin: 1.8rem 0;
    }

    .draw-mini-gift {
        width: 88px;
        height: 88px;
        border-radius: 22px;
        position: relative;
        animation: drawGiftSwap 0.9s ease-in-out infinite alternate;
        box-shadow: 0 18px 30px rgba(0, 0, 0, 0.18);
    }

    .draw-mini-gift::before,
    .draw-mini-gift::after {
        content: "";
        position: absolute;
        background: rgba(255, 244, 218, 0.94);
    }

    .draw-mini-gift::before {
        left: 50%;
        top: 0;
        width: 16%;
        height: 100%;
        transform: translateX(-50%);
    }

    .draw-mini-gift::after {
        left: 0;
        top: 42%;
        width: 100%;
        height: 16%;
    }

    .draw-mini-gift-red { background: linear-gradient(180deg, #cf3348, #931a2c); }
    .draw-mini-gift-gold { background: linear-gradient(180deg, #efcf72, #c7921d); animation-delay: .15s; }
    .draw-mini-gift-green { background: linear-gradient(180deg, #1ea06b, #116647); animation-delay: .3s; }

    .draw-countdown {
        font-size: 5rem;
        line-height: 1;
        font-weight: 900;
        color: #b7263d;
    }

    .draw-status {
        margin-top: 0.85rem;
        color: rgba(29, 36, 31, 0.72);
        font-weight: 700;
    }

    @@keyframes drawGiftSwap {
        from { transform: translateY(0) rotate(-5deg) scale(1); }
        to { transform: translateY(-12px) rotate(5deg) scale(1.04); }
    }

    @@keyframes drawTwinkle {
        from { opacity: 0.5; transform: translateY(0); }
        to { opacity: 1; transform: translateY(-2px); }
    }
</style>

@section Scripts {
    <script>
        (() => {
            const countdown = document.querySelector("[data-draw-countdown]");
            if (!countdown) {
                return;
            }

            let seconds = 5;
            const tick = () => {
                seconds -= 1;
                countdown.textContent = String(Math.max(seconds, 0));
                if (seconds > 0) {
                    window.setTimeout(tick, 1000);
                }
            };

            window.setTimeout(tick, 1000);
        })();
    </script>
}
